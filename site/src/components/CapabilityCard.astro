---
import MotifIcon from './MotifIcon.astro';

interface Props {
  title: string;
  description: string;
  icon:
    | 'circles'
    | 'cube'
    | 'eye'
    | 'flow'
    | 'microphone'
    | 'pencil';
}

const { title, description, icon } = Astro.props;
---

<article class="capability-card">
  <MotifIcon name={icon} class="capability-icon" />
  <h3>{title}</h3>
  <p>{description}</p>
</article>
